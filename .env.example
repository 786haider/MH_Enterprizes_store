# Supabase (Project Settings > API). Leave empty to run in demo mode with sample data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Public site URL (used for canonical URLs, sitemap, WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional
NEXT_PUBLIC_GA_ID=
